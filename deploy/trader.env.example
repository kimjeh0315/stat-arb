# Credential contract for the planned four-venue execution service.
# This template does not enable trading; the execution service is not implemented yet.
# Keep real values ONLY on the server at /etc/quant/trader.env (root-owned, mode 0600).
# Never use a main-wallet private key or seed phrase. Use dedicated trading signers.
# Do not source untrusted env files in a shell.

# Bybit: system-generated HMAC key, derivatives trading + account read permissions.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Aster Futures V3: account address + authorized API/agent wallet signer.
ASTER_USER_ADDRESS=
ASTER_SIGNER_ADDRESS=
ASTER_SIGNER_PRIVATE_KEY=

# GRVT: Trading Account API key and its registered signing wallet.
GRVT_API_KEY=
GRVT_SUB_ACCOUNT_ID=
GRVT_SIGNER_ADDRESS=
GRVT_SIGNER_PRIVATE_KEY=

# Hyperliquid: account address + a dedicated, approved API wallet (not the main key).
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_API_WALLET_ADDRESS=
HYPERLIQUID_API_WALLET_PRIVATE_KEY=
