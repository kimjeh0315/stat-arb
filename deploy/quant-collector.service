[Unit]
Description=Quant public perpetual market collector
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=quant
Group=quant
WorkingDirectory=/opt/quant
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=QUANT_SPOOL_DIR=/var/lib/quant-collector
EnvironmentFile=/etc/quant/collector.env
ExecStart=/opt/quant/.venv/bin/quant-collector --config /opt/quant/config/collector.json run
Restart=on-failure
RestartSec=30
TimeoutStopSec=120
KillSignal=SIGTERM
UMask=0077
StateDirectory=quant-collector
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quant-collector

[Install]
WantedBy=multi-user.target
